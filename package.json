{
  "name": "server",
  "version": "1.0.0",
  "description": "Backend da plataforma Cub's",
  "private": true,
  "main": "dist/server.js",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11.19.0 <13"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env.development src/server.ts",
    "dev:lan": "tsx watch --env-file=.env.lan src/server.ts",
    "start:dev": "tsx --env-file=.env.development src/server.ts",
    "clean": "node scripts/clean-build.mjs",
    "build": "npm run clean && rqlite check && tsc && tsc-alias --resolve-full-paths --resolve-full-extension .js && node scripts/copy-mail-templates.mjs && rqlite prepare",
    "start": "node --env-file=.env.production dist/server.js",
    "start:container": "node dist/server.js",
    "seed": "tsx --env-file=.env.development --env-file=.env.seed scripts/seed.ts",
    "backfill:database-views": "tsx --env-file=.env.development scripts/backfill-database-views.ts",
    "realtime:contract:sync": "tsx scripts/realtime-contract.ts sync",
    "realtime:contract:check": "tsx scripts/realtime-contract.ts check",
    "database:contract:sync": "tsx scripts/database-query-contract.ts sync",
    "database:contract:check": "tsx scripts/database-query-contract.ts check",
    "document:codec:sync": "node scripts/page-document-codec.mjs sync",
    "document:codec:check": "node scripts/page-document-codec.mjs check",
    "mentions:contract:sync": "node scripts/mention-contract.mjs sync",
    "mentions:contract:check": "node scripts/mention-contract.mjs check",
    "database:backfill": "tsx --env-file=.env.development scripts/backfill-database-views.ts",
    "test": "vitest run",
    "test:workspace-flow": "tsx --env-file=.env.development scripts/validation/workspace-flow-test.ts",
    "test:sql-injection": "tsx --env-file=.env.development scripts/validation/sql-injection-test.ts",
    "deps:outdated": "npm outdated --long",
    "deps:audit": "npm audit",
    "rqlite:generate": "rqlite generate",
    "rqlite:check": "rqlite check",
    "rqlite:create": "rqlite create migration",
    "rqlite:migrate": "rqlite migrate",
    "rqlite:status": "rqlite migrate status",
    "rqlite:watch": "rqlite watch",
    "rqlite:dev": "rqlite watch --env-file .env.development --apply --environment development --run src/server.ts",
    "rqlite:test:cubs": "node scripts/validation/rqlite-cubs-test.mjs",
    "formula:engine:sync": "node scripts/formula-engine.mjs sync",
    "formula:engine:check": "node scripts/formula-engine.mjs check",
    "recursive:contract:sync": "node scripts/recursive-contract.mjs sync",
    "recursive:contract:check": "node scripts/recursive-contract.mjs check",
    "pdf:setup": "puppeteer browsers install chrome",
    "pdf:preview:check": "tsx --env-file=.env.development scripts/validation/page-pdf-preview.ts",
    "pdf:example:prepare": "tsx --env-file=.env.development scripts/validation/page-pdf-example.ts prepare",
    "pdf:example:review": "tsx --env-file=.env.development scripts/validation/page-pdf-example.ts review",
    "pdf:example:send": "tsx --env-file=.env.development scripts/validation/page-pdf-example.ts send",
    "pdf:example:browser": "node --env-file=.env.development scripts/validation/page-pdf-example-browser.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@napi-rs/canvas": "1.0.13",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/katex": "0.16.8",
    "@types/node": "24.13.6",
    "pdfjs-dist": "6.4.299",
    "socket.io-client": "4.8.3",
    "tsc-alias": "1.9.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "dependencies": {
    "@casl/ability": "7.0.1",
    "@cubs/rqlite-client": "1.0.0",
    "@fontsource-variable/noto-sans": "5.2.10",
    "@iconify-json/cuida": "1.2.5",
    "@iconify-json/lucide": "1.2.135",
    "bcryptjs": "3.0.3",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "fflate": "0.8.3",
    "fractional-indexing": "4.0.0",
    "helmet": "8.3.0",
    "highlight.js": "11.12.0",
    "jsonwebtoken": "9.0.3",
    "katex": "0.18.4",
    "nodemailer": "10.0.10",
    "puppeteer": "25.16.0",
    "socket.io": "4.8.3",
    "ulid": "3.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "puppeteer@25.16.0": true
  }
}
