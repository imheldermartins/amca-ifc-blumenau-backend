# Notebook/WSL: primeiro node e origem dos dados do cluster.
RQLITE_VERSION=10.3.2
RQLITE_CONTAINER_NAME=amca-rqlite-wsl-leader
RQLITE_NODE_ID=amca-wsl-leader
RQLITE_NODE_ROLE=leader
RQLITE_NETWORK_MODE=tailscale

# Portas publicadas no host. Com 127.0.0.1, publique-as na tailnet usando
# `tailscale serve --tcp` conforme docs/RQLITE_CLUSTER.md.
RQLITE_PUBLISH_HOST=127.0.0.1
RQLITE_HTTP_HOST_PORT=8001
RQLITE_RAFT_HOST_PORT=4003

# Enderecos que o Termux realmente consegue alcancar. Troque pelos IPs ou
# nomes MagicDNS atuais do Tailscale; nunca anuncie 0.0.0.0/localhost.
RQLITE_HTTP_ADV_ADDR=100.98.198.19:8001
RQLITE_RAFT_ADV_ADDR=100.98.198.19:4003
RQLITE_JOIN_ADDRS=

RQLITE_JOIN_ATTEMPTS=20
RQLITE_JOIN_INTERVAL=3s
RQLITE_COMPRESS_SNAPSHOT_TRANSPORT=true

# CORS nao autoriza nodes. Deixe vazio salvo se um browser chamar a API rqlite.
RQLITE_HTTP_ALLOW_ORIGIN=

# Arquivos opcionais montados de docker/rqlite/security em /run/rqlite-security.
RQLITE_AUTH_FILE=
RQLITE_JOIN_AS=
RQLITE_HTTP_CERT=
RQLITE_HTTP_KEY=
RQLITE_HTTP_CA_CERT=
RQLITE_HTTP_VERIFY_CLIENT=false
RQLITE_NODE_CERT=
RQLITE_NODE_KEY=
RQLITE_NODE_CA_CERT=
RQLITE_NODE_VERIFY_CLIENT=false
RQLITE_NODE_NO_VERIFY=false
RQLITE_NODE_VERIFY_SERVER_NAME=
RQLITE_NODE_VERIFY_COMMON_NAME=
RQLITE_ALLOW_INSECURE_TUNNEL=false
RQLITE_SECURITY_DIR=./rqlite/security
