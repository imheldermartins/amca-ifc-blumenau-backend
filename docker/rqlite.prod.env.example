# Node unico interno do compose de producao. Para cluster entre hosts, use
# docker-compose.rqlite-cluster.yml e um dos templates rqlite.*.env.example.
RQLITE_NODE_ID=prod-node-1
RQLITE_NODE_ROLE=leader
RQLITE_NETWORK_MODE=direct

# O backend e o rqlite compartilham a rede Docker e usam as portas internas.
RQLITE_HTTP_ADV_ADDR=rqlite:4001
RQLITE_RAFT_ADV_ADDR=rqlite:4002
RQLITE_JOIN_ADDRS=
RQLITE_JOIN_ATTEMPTS=20
RQLITE_JOIN_INTERVAL=3s

# CORS autoriza somente browsers na API HTTP; nao autoriza peers Raft.
RQLITE_HTTP_ALLOW_ORIGIN=

# Seguranca opcional. Monte os arquivos no container antes de usar estes paths.
RQLITE_AUTH_FILE=
RQLITE_JOIN_AS=
RQLITE_HTTP_CERT=
RQLITE_HTTP_KEY=
RQLITE_HTTP_CA_CERT=
RQLITE_HTTP_VERIFY_CLIENT=false
RQLITE_NODE_CERT=
RQLITE_NODE_KEY=
RQLITE_NODE_CA_CERT=
RQLITE_NODE_VERIFY_CLIENT=false
RQLITE_NODE_NO_VERIFY=false
RQLITE_NODE_VERIFY_SERVER_NAME=
RQLITE_NODE_VERIFY_COMMON_NAME=
RQLITE_COMPRESS_SNAPSHOT_TRANSPORT=false
