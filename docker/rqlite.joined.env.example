# Termux: replica geografica. Non-voter replica tudo sem colocar o quorum do
# notebook na dependencia de bateria/rede/processo do celular.
RQLITE_VERSION=10.3.2
RQLITE_CONTAINER_NAME=amca-rqlite-termux-replica
RQLITE_NODE_ID=amca-termux-replica
RQLITE_NODE_ROLE=non-voter
RQLITE_NETWORK_MODE=tailscale

RQLITE_PUBLISH_HOST=127.0.0.1
RQLITE_HTTP_HOST_PORT=8001
RQLITE_RAFT_HOST_PORT=4003

# Enderecos deste Termux vistos pelo notebook.
RQLITE_HTTP_ADV_ADDR=100.80.19.27:8001
RQLITE_RAFT_ADV_ADDR=100.80.19.27:4003

# Raft anunciado pelo node inicial. O join nao usa a URL HTTP/CORS.
RQLITE_JOIN_ADDRS=100.98.198.19:4003

RQLITE_JOIN_ATTEMPTS=20
RQLITE_JOIN_INTERVAL=3s
RQLITE_COMPRESS_SNAPSHOT_TRANSPORT=true
RQLITE_HTTP_ALLOW_ORIGIN=

RQLITE_AUTH_FILE=
RQLITE_JOIN_AS=
RQLITE_HTTP_CERT=
RQLITE_HTTP_KEY=
RQLITE_HTTP_CA_CERT=
RQLITE_HTTP_VERIFY_CLIENT=false
RQLITE_NODE_CERT=
RQLITE_NODE_KEY=
RQLITE_NODE_CA_CERT=
RQLITE_NODE_VERIFY_CLIENT=false
RQLITE_NODE_NO_VERIFY=false
RQLITE_NODE_VERIFY_SERVER_NAME=
RQLITE_NODE_VERIFY_COMMON_NAME=
RQLITE_ALLOW_INSECURE_TUNNEL=false
RQLITE_SECURITY_DIR=./rqlite/security
