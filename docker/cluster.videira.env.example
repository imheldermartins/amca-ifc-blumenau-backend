# New native Linux host only. Never initialize a second cluster.
CLUSTER_SITE=videira
CLUSTER_NODE_ID=ifc-videira
CLUSTER_PUBLIC_HOST=ifc-videira.cubsonline.com.br
CLUSTER_MESH_IP=
# Existing private Raft endpoints, port 4002; retain a surviving JOIN target.
CLUSTER_JOIN_PEERS=
CLUSTER_NON_VOTER=true
CLUSTER_DOCKER_SUBNET=172.30.21.0/24
CLUSTER_AUTH_FILE=/etc/cubs/cluster/rqlite-auth.json
CLUSTER_HEALTH_FILE=/etc/cubs/cluster/rqlite-health.curl
# Fill the three distinct private Mesh endpoints; never point only at Blumenau.
CLUSTER_REDIS_SENTINELS=
COORDINATION_PRIMARY_IP=
CLUSTER_REDIS_PASSWORD_FILE=/etc/cubs/cluster/coordination.hex
CAMPUS_BACKEND_ENV=/etc/cubs/cluster/backend.env
CAMPUS_TUNNEL_ENV=/etc/cubs/cluster/cloudflare.env
# Must match the existing app credentials without printing them.
RQLITE_USERNAME=
RQLITE_PASSWORD=
