# Blumenau is the existing host: keep project docker, persistent node ID 1 and volume.
CLUSTER_SITE=blumenau
CLUSTER_NODE_ID=1
CLUSTER_PUBLIC_HOST=ifc-blumenau.cubsonline.com.br
CLUSTER_MESH_IP=
CLUSTER_ORIGIN_DOCKER_IP=
CLUSTER_ORIGIN_DOCKER_NETWORK=
CLUSTER_AUTH_FILE=/etc/cubs/cluster/rqlite-auth.json
# Fill the three distinct private Mesh endpoints; never point only at Blumenau.
CLUSTER_REDIS_SENTINELS=
COORDINATION_PRIMARY_IP=
CLUSTER_REDIS_PASSWORD_FILE=/etc/cubs/cluster/coordination.hex
CAMPUS_BACKEND_ENV=/etc/cubs/cluster/backend.env
CAMPUS_TUNNEL_ENV=/etc/cubs/cluster/cloudflare.env
# Must match the existing app credentials without printing them.
RQLITE_USERNAME=
RQLITE_PASSWORD=
