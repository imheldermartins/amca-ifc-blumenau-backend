upstream cubs_backend { server backend:3000; }
map $http_cf_connecting_ip $cubs_forwarded_for {
    default $http_cf_connecting_ip;
    "" $proxy_add_x_forwarded_for;
}
# The retired apex is not another application on this campus.
server { listen 80 default_server; server_name _; return 404; }
server {
    listen 80;
    server_name ${CAMPUS_PUBLIC_HOST};
    root /usr/share/nginx/html;
    index index.html;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://${CAMPUS_PUBLIC_HOST} wss://${CAMPUS_PUBLIC_HOST} https://api.iconify.design; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    location / { try_files $uri $uri/ /index.html; }
    location /api/v1/ {
        proxy_pass http://cubs_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $cubs_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
    location /health/ {
        proxy_pass http://cubs_backend;
        proxy_set_header Host $host;
    }
    location /socket.io/ {
        proxy_pass http://cubs_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $cubs_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }
}
